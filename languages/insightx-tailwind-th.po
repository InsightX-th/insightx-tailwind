msgstr "กำลังตรวจหน้า %s จาก %s…"

#: src/I18n.php:38
msgid "Classes"
msgstr "Class"

#: src/I18n.php:39
msgid "Click Save & Build to scan the site and regenerate the CSS."
msgstr "กด บันทึกและ Build เพื่อสแกนเว็บแล้วสร้าง CSS ใหม่"

#: src/I18n.php:40
msgid "Color palette (theme.json)"
msgstr "ชุดสี (theme.json)"

#: src/I18n.php:41
msgid "Colors and fonts you define in @theme, e.g. --color-brand."
msgstr "เฉพาะสีและฟอนต์ที่กำหนดเองใน @theme เช่น --color-brand"

