#: src/Admin.php:26 src/Admin.php:27
msgid "InsightX Tailwind"
msgstr "InsightX Tailwind"

#: src/Admin.php:76
msgid "Tailwind CSS is out of date: content changed since the last build."
msgstr "Tailwind CSS ยังไม่อัปเดต: มีการแก้เนื้อหาหลังจาก build ครั้งล่าสุด"

#: src/Admin.php:78
msgid "Rebuild now"
msgstr "Build ใหม่ตอนนี้"

#: src/Admin.php:88
msgid "Settings"
msgstr "ตั้งค่า"

#: src/I18n.php:19
#, php-format
msgid ""
"%s of %s pages use classes the scanner missed. Find where they are stored, "
"enable that source, then rebuild."
msgstr ""
"มี %s จาก %s หน้าที่ใช้ class ที่ scanner หาไม่เจอ ดูว่า class เก็บอยู่ที่ไหน เปิดแหล่งสแกนนั้น "
"แล้ว build ใหม่"

#: src/I18n.php:20
#, php-format
msgid "%s pages"
msgstr "%s หน้า"

#: src/I18n.php:21
#, php-format
msgid "%s: page %s (%s items)"
msgstr "%s: หน้า %s (%s รายการ)"

#: src/I18n.php:22
msgid ""
"Add Tailwind colors and fonts to the Gutenberg color and font pickers. "
"Applied on the next build."
msgstr ""
"เพิ่มสีและฟอนต์ของ Tailwind ลงในตัวเลือกสีและฟอนต์ของ Gutenberg มีผลตอน build ครั้งถัดไป"

#: src/I18n.php:23
msgid "Add attribute"
msgstr "เพิ่ม attribute"

#: src/I18n.php:24
#, php-format
msgid "All %s pages are covered. No missing classes."
msgstr "ครบทั้ง %s หน้า ไม่มี class ที่ขาด"

#: src/I18n.php:25
msgid "All Tailwind colors"
msgstr "สี Tailwind ทั้งหมด"

#: src/I18n.php:26
msgid "All pages"
msgstr "ทุกหน้า"

#: src/I18n.php:27
msgid "Also the full default palette (250+ swatches)."
msgstr "รวม palette มาตรฐานทั้งชุดด้วย (มากกว่า 250 สี)"

#: src/I18n.php:28
msgid "Attribute name"
msgstr "ชื่อ attribute"

#: src/I18n.php:29
msgid "Attribute value"
msgstr "ค่า attribute"

#: src/I18n.php:30
msgid "Attributes"
msgstr "Attribute"

#: src/I18n.php:31
msgid "Build & cache"
msgstr "Build และ Cache"

#: src/I18n.php:32
msgid "Build reads these sources and generates CSS only for classes it finds."
msgstr "ตอน build ระบบจะอ่านจากแหล่งเหล่านี้ และสร้าง CSS เฉพาะ class ที่เจอเท่านั้น"

#: src/I18n.php:33
msgid "Building…"
msgstr "กำลัง build…"

#: src/I18n.php:34
msgid "CSS cache"
msgstr "CSS Cache"

#: src/I18n.php:35
msgid "CSS files"
msgstr "ไฟล์ CSS"

