#: src/I18n.php:46
#, php-format
msgid "Delete %s"
msgstr "ลบ %s"

#: src/I18n.php:47
#, php-format
msgid "Delete %s? Remember to remove its @import from main.css."
msgstr "ลบ %s ใช่ไหม? อย่าลืมเอา @import ของไฟล์นี้ออกจาก main.css ด้วย"

